// ========================================
// SPRINT C — DOCUMENT MANAGEMENT
// ========================================

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
  REQUESTED
  EXPIRED
}

enum DocumentCategory {
  IDENTITY
  ACADEMIC
  FINANCIAL
  PROGRAM
  OTHER
}

model DocumentType {
  id               String                       @id @default(cuid())
  name             String
  code             String                       @unique
  category         DocumentCategory
  description      String?
  isRequired       Boolean                      @default(true)
  acceptedFormats  String                       @default("pdf,jpg,png")
  maxSizeMb        Int                          @default(5)
  hasExpiry        Boolean                      @default(false)
  programs         ProgramDocumentRequirement[]
  documents        Document[]
  documentRequests DocumentRequest[]
  createdAt        DateTime                     @default(now())

  @@map("document_types")
}

model ProgramDocumentRequirement {
  id             String       @id @default(cuid())
  programId      String
  documentTypeId String
  isRequired     Boolean      @default(true)
  notes          String?
  program        Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])

  @@unique([programId, documentTypeId])
  @@map("program_document_requirements")
}

model Document {
  id              String            @id @default(cuid())
  seekerId        String
  documentTypeId  String
  uploadedById    String
  verifiedById    String?
  cloudinaryId    String
  cloudinaryUrl   String
  thumbnailUrl    String?
  fileName        String
  fileSize        Int
  fileFormat      String
  folder          String
  status          DocumentStatus    @default(PENDING)
  rejectionReason String?
  notes           String?
  expiryDate      DateTime?
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  seeker          Seeker            @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  documentType    DocumentType      @relation(fields: [documentTypeId], references: [id])
  uploadedBy      User              @relation("DocumentUploader", fields: [uploadedById], references: [id])
  verifiedBy      User?             @relation("DocumentVerifier", fields: [verifiedById], references: [id])
  versions        DocumentVersion[]

  @@map("documents")
}

model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  versionNumber Int
  cloudinaryId  String
  cloudinaryUrl String
  fileSize      Int
  uploadedById  String
  notes         String?
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy    User     @relation("VersionUploader", fields: [uploadedById], references: [id])
  createdAt     DateTime @default(now())

  @@map("document_versions")
}

model DocumentRequest {
  id             String       @id @default(cuid())
  seekerId       String
  documentTypeId String
  requestedById  String
  message        String?
  dueDate        DateTime?
  fulfilled      Boolean      @default(false)
  reminderCount  Int          @default(0)
  lastReminderAt DateTime?
  seeker         Seeker       @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])
  requestedBy    User         @relation("DocumentRequester", fields: [requestedById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("document_requests")
}

// ========================================
// SPRINT D — PAYMENTS & INVOICING
// ========================================

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIAL
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  ONLINE
  OTHER
}

model Invoice {
  id         String        @id @default(cuid())
  seekerId   String
  invoiceNo  String        @unique
  issuedDate DateTime      @default(now())
  dueDate    DateTime?
  subtotal   Decimal       @db.Decimal(10, 2)
  discount   Decimal       @default(0) @db.Decimal(10, 2)
  total      Decimal       @db.Decimal(10, 2)
  status     PaymentStatus @default(PENDING)
  notes      String?
  seeker     Seeker        @relation(fields: [seekerId], references: [id])
  items      InvoiceItem[]
  payments   Payment[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  qty         Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod
  reference    String?
  paidAt       DateTime      @default(now())
  recordedById String
  notes        String?
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  recordedBy   User          @relation("PaymentRecorder", fields: [recordedById], references: [id])

  @@map("payments")
}

// ========================================
// SPRINT E — EVENTS MANAGEMENT
// ========================================

enum EventType {
  OPEN_DAY
  EXHIBITION
  SEMINAR
  WEBINAR
  WORKSHOP
  OTHER
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

model Event {
  id            String              @id @default(cuid())
  title         String
  description   String?
  type          EventType
  status        EventStatus         @default(UPCOMING)
  startAt       DateTime
  endAt         DateTime
  venue         String?
  onlineLink    String?
  maxAttendees  Int?
  imageUrl      String?
  createdById   String
  createdBy     User                @relation("EventCreatedBy", fields: [createdById], references: [id])
  registrations EventRegistration[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@map("events")
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  seekerId  String?
  name      String
  email     String
  phone     String?
  attended  Boolean  @default(false)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seeker    Seeker?  @relation(fields: [seekerId], references: [id])
  createdAt DateTime @default(now())

  @@map("event_registrations")
}

// ========================================
// SPRINT F — SMS CAMPAIGNS
// ========================================

model SMSMessage {
  id         String         @id @default(cuid())
  userId     String
  body       String
  sender     String
  createdBy  User           @relation("SMSMessageCreator", fields: [userId], references: [id])
  recipients SMSRecipient[]
  createdAt  DateTime       @default(now())

  @@map("sms_messages")
}

model SMSRecipient {
  id        String     @id @default(cuid())
  messageId String
  phone     String
  status    String     @default("QUEUED")
  sentAt    DateTime?
  message   SMSMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("sms_recipients")
}

// ========================================
// SPRINT G — ALUMNI MANAGEMENT
// ========================================

enum AlumniStatus {
  EMPLOYED
  SELF_EMPLOYED
  STUDYING
  UNEMPLOYED
  UNKNOWN
}

model Alumni {
  id          String             @id @default(cuid())
  seekerId    String             @unique
  graduatedAt DateTime
  programId   String?
  currentRole String?
  employer    String?
  status      AlumniStatus       @default(UNKNOWN)
  linkedinUrl String?
  testimonial String?
  isPublic    Boolean            @default(false)
  seeker      Seeker             @relation(fields: [seekerId], references: [id])
  program     Program?           @relation(fields: [programId], references: [id])
  engagements AlumniEngagement[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("alumni")
}

model AlumniEngagement {
  id        String   @id @default(cuid())
  alumniId  String
  type      String
  notes     String?
  alumni    Alumni   @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("alumni_engagements")
}

// SAVED FILTERS (for Inquiries and other views)
// ========================================

model SavedFilter {
  id          String   @id @default(cuid())
  name        String
  description String?
  entityType  String   @default("inquiry") // "inquiry", "task", "campaign", etc.
  filterData  Json // Serialized filter state (searchQuery, stages, dateRange, etc.)
  isDefault   Boolean  @default(false)
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userId String
  user   User   @relation("UserSavedFilters", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, entityType])
  @@index([isDefault])
  @@map("saved_filters")
}

enum ProjectRole {
  OWNER
  MANAGER
  CONTRIBUTOR
  VIEWER
}

model EmailAccount {
  id           String        @id @default(cuid())
  userId       String
  provider     String        // "GMAIL" or "MICROSOFT"
  email        String        @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  threads      EmailThread[]

  @@map("email_accounts")
}

model EmailThread {
  id               String              @id @default(cuid())
  providerThreadId String              // Thread ID from Gmail/Microsoft
  emailAccountId   String
  seekerId         String?             // Associated student/seeker ID (null if not matched)
  subject          String
  lastMessageAt    DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  emailAccount     EmailAccount        @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  seeker           Seeker?             @relation(fields: [seekerId], references: [id], onDelete: SetNull)
  messages         EmailInboxMessage[]

  @@unique([emailAccountId, providerThreadId])
  @@map("email_threads")
}

model EmailInboxMessage {
  id                String                 @id @default(cuid())
  providerMessageId String                 @unique // Message ID from Gmail/Microsoft
  threadId          String
  from              String
  to                String
  subject           String
  body              String                 // HTML or plain text body
  direction         String                 // "INBOUND" or "OUTBOUND"
  sentAt            DateTime
  isRead            Boolean                @default(false)
  openCount         Int                    @default(0)
  lastOpenedAt      DateTime?
  createdAt         DateTime               @default(now())

  thread            EmailThread            @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments       EmailInboxAttachment[]

  @@map("email_inbox_messages")
}

model EmailInboxAttachment {
  id        String            @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  content   String?           // Base64 content or URL
  messageId String
  createdAt DateTime          @default(now())

  message   EmailInboxMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("email_inbox_attachments")
}

model CallLog {
  id             String        @id @default(cuid())
  seekerId       String
  userId         String
  direction      String        // "INBOUND" or "OUTBOUND"
  status         String        // "completed", "no-answer", "busy", "failed"
  duration       Int           // duration in seconds
  notes          String?
  recordingUrl   String?
  callSid        String?       @unique // twilio call sid
  followUpTaskId String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  seeker         Seeker        @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  followUpTask   FollowUpTask? @relation(fields: [followUpTaskId], references: [id], onDelete: SetNull)

  @@map("call_logs")
}
